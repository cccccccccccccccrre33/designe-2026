# Скопируйте в .env (файл не коммитится). Пустое значение = не задано.

# ── Bedrock (локальный режим) ─────────────────────────────────────────────
# Long-term API key из консоли Bedrock → API keys. Работает только для Bedrock Runtime.
AWS_BEARER_TOKEN_BEDROCK=
# us-west-2: там Stability (Core/Ultra), MiniMax, Kimi, GLM, Claude через us.-профиль.
BEDROCK_REGION=us-west-2
# on — генерировать фото напитков через Stability (тратит бюджет генераций).
STUDIO_IMAGES=off
# scripted — сценарные ответы без вызова моделей (демо, проверка механики).
STUDIO_MODE=

# ── Telegram ──────────────────────────────────────────────────────────────
# @BotFather → /newbot. Бот отвечает только владельцу с указанным числовым id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Для режима вебхука (этап 5): секрет, который Telegram присылает в заголовке.
TELEGRAM_WEBHOOK_SECRET=

# ── GitHub ────────────────────────────────────────────────────────────────
# Fine-grained token только на designe-2026: Contents RW, Pull requests RW, Issues RW.
GITHUB_TOKEN=
GITHUB_REPO=cccccccccccccccrre33/designe-2026

# ── GitHub Actions (ADR-0007) ─────────────────────────────────────────────
# Ключ шифрования состояния в ветке studio-state: 32 байта в base64. В Actions — секрет
# репозитория с тем же именем; локально нужен только для npm run studio -- actions-session.
STUDIO_STATE_KEY=

# ── Рендер ────────────────────────────────────────────────────────────────
# Путь к Chrome/Edge, если не найден автоматически.
BROWSER_PATH=
